{
 "name": "noor-quran",
 "version": "1.0.0",
 "private": true,
 "description": "Noor Quran - PWA + Android (Capacitor)",
 "scripts": {
  "test": "node logic.test.js",
  "build:www": "node build-www.js",
  "icons": "capacitor-assets generate --android",
  "android:add": "cap add android",
  "sync": "npm run build:www && cap sync android",
  "apk:debug": "npm run build:www && node patch-android.js && cap sync android && cd android && ./gradlew assembleDebug",
  "android:patch": "node patch-android.js"
 },
 "dependencies": {
  "@capacitor/android": "^8.0.0",
  "@capacitor/core": "^8.0.0"
 },
 "devDependencies": {
  "@capacitor/assets": "^3.0.5",
  "@capacitor/cli": "^8.0.0"
 }
}